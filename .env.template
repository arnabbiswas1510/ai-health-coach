# ─────────────────────────────────────────────────────────────────────────────
# SECRET RESOLUTION — READ BEFORE EDITING
# This file is COMMITTED and PUBLIC. It must never contain a real secret value.
# Every secret below is the sentinel `@bws`; scripts/render_env.sh resolves each
# one from Bitwarden Secrets Manager (by the exact variable name) at deploy time
# and writes the real, gitignored .env. Non-secret config lines are literal and
# used as-is. To add a secret: store it in the `ai-health-coach` Bitwarden
# project under the same name, then set its line here to `@bws`.
# ─────────────────────────────────────────────────────────────────────────────

# LLM providers (use at least one)
# For direct Google Gemini, use GOOGLE_API_KEY (or GEMINI_API_KEY)
#
# Only GOOGLE_API_KEY carries the @bws sentinel: every AI mode maps the agent
# roles this app actually runs to gemini-2.5-flash. The other providers are left
# blank because render_env.py treats an empty resolved secret as MISSING and
# aborts the whole render, so a sentinel here would force you to invent a
# throwaway Bitwarden secret just to satisfy the resolver. Add the sentinel back
# alongside a real secret if you switch providers.
GOOGLE_API_KEY=@bws
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Garmin Credentials (optional for token-only paths, required for first login /
# MFA refresh and some scripts)
GARMIN_EMAIL=@bws
GARMIN_PASSWORD=@bws

# Athlete Profile overrides (if using environment variables instead of
# coach_config.yaml)
# ATHLETE_NAME=Arnab                     # Optional override (retrieved automatically from Garmin Connect)
# ATHLETE_AGE=53                         # Used for Max HR / Zone 2 calculation
# TARGET_GOAL=base_building              # e.g., base_building, maintenance
# SYNC_CALENDAR=true                     # Sync workouts to Garmin Connect calendar
# MISSED_RUNS_COUNT=0
# ACCUMULATED_DEBT_KM=0.0
# ATHLETE_HEIGHT="5'9\""                 # Golden source is Garmin Connect, fallback to this
# ATHLETE_WEIGHT=70.0                    # Golden source is Garmin Connect, fallback to this
# WEIGHT_GOAL=maintain_lower_healthy_range # e.g., maintain_lower_healthy_range, weight_loss

# Context overrides
# CONTEXT_ANALYSIS="My analysis context details..."
# CONTEXT_PLANNING="My planning context details..."

# Extraction overrides
# ACTIVITIES_DAYS=180
# METRICS_DAYS=28
# ENABLE_PLOTTING=false
# HITL_ENABLED=false
# SKIP_SYNTHESIS=false
# OUTPUT_DIR=./data

# ── Daemon / NAS deployment ──────────────────────────────────────────────────
# How often the poller checks Garmin Connect for new activities (seconds)
POLL_INTERVAL_SECONDS=3600
# Set to true to force full analysis on startup even if HTML files exist
FORCE_ANALYTICS=false

# ── Athlete profile ──────────────────────────────────────────────────────────
# Non-secret, so these carry literal values rather than the @bws sentinel.
# They are declared here (not merely commented out) because .env is rendered
# from this template wholesale: a key that is absent here is silently dropped
# from .env on render, and docker-compose.yml substitutes its own default
# instead. Declaring them keeps the template the single source of truth.
ATHLETE_NAME=
ATHLETE_AGE=53
ATHLETE_HEIGHT=
ATHLETE_WEIGHT=
WEIGHT_GOAL=
TARGET_GOAL=base_building

# ── Training context ─────────────────────────────────────────────────────────
CONTEXT_ANALYSIS=
CONTEXT_PLANNING=
ACTIVITIES_DAYS=7
METRICS_DAYS=14
MISSED_RUNS_COUNT=0
ACCUMULATED_DEBT_KM=0.0

# Competitions (JSON array)
# Example: '[{"name": "Local 10K", "date": "2026-07-04", "race_type": "running", "priority": "A"}]'
COMPETITIONS=[]

# ── Feature flags ────────────────────────────────────────────────────────────
SYNC_CALENDAR=false
ENABLE_PLOTTING=false
HITL_ENABLED=true
SKIP_SYNTHESIS=false

# Observability (optional) — blank rather than @bws for the same reason as the
# unused LLM providers above.
LANGSMITH_API_KEY=

# App mode: development | standard | cost_effective | pro
# Provider mapping depends on AI mode:
#   cost_effective -> Google (gemini-1.5-flash) | requires GOOGLE_API_KEY
#   development    -> Google (gemini-1.5-flash) | requires GOOGLE_API_KEY
#   standard       -> Google (gemini-2.0-flash) | requires GOOGLE_API_KEY
#   pro            -> Google (gemini-2.0-pro-exp)| requires GOOGLE_API_KEY
AI_MODE=standard

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Logseq SSH direct-write (no Logseq process or HTTP API required)
# Writes directly to Logseq daily journal .md files via SSH/SFTP from DietPi container
LOGSEQ_SSH_HOST=@bws
LOGSEQ_SSH_USER=@bws
LOGSEQ_SSH_PORT=22
LOGSEQ_SSH_KEY_PATH=/root/.ssh/id_ed25519
# Absolute path to Logseq graph or journals directory on host machine
LOGSEQ_GRAPH_PATH=@bws
